<!-- Stops MSBuild from importing the repository's Directory.Build.props: this sample builds like a user's project. Only
     the package audit and the security analyzers are repeated (owner's decisions, 2026-11-06;
     docs/decisions/packaging-and-releases.md): a vulnerable package, direct or transitive, or a Security rule's finding
     fails the image's build too. Directory.Build.targets beside this file repeats the check that the rules are errors. -->
<Project>
  <PropertyGroup>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <WarningsAsErrors>$(WarningsAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
    <AnalysisModeSecurity>All</AnalysisModeSecurity>
    <_GlobalAnalyzerConfigFileName_MicrosoftCodeAnalysisNetAnalyzersSecurity_WarnAsErrorSuffix>_warnaserror</_GlobalAnalyzerConfigFileName_MicrosoftCodeAnalysisNetAnalyzersSecurity_WarnAsErrorSuffix>
  </PropertyGroup>
</Project>
