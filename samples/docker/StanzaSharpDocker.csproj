<Project Sdk="Microsoft.NET.Sdk">

  <!-- A standalone app, as in your own project: only the Linux platform package (StanzaSharp + Linux x64 libtorch).
       StanzaSharpVersion: * is the latest release; CI passes the version it just packed. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <StanzaSharpVersion Condition="'$(StanzaSharpVersion)' == ''">*</StanzaSharpVersion>
    <!-- Leaves out libtorch files StanzaSharp never loads (libtorch_python.so and others, about 35 MB). -->
    <StanzaSharpTrimNative>true</StanzaSharpTrimNative>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="StanzaSharp.Cpu.Linux" Version="$(StanzaSharpVersion)" />
  </ItemGroup>

</Project>
