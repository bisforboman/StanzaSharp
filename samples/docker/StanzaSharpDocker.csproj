<Project Sdk="Microsoft.NET.Sdk">

  <!-- A standalone app, as in your own project: only StanzaSharp, whose default (managed) backend needs no native
       libraries. StanzaSharpVersion: * is the latest release; CI passes the version it just packed. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <StanzaSharpVersion Condition="'$(StanzaSharpVersion)' == ''">*</StanzaSharpVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="StanzaSharp" Version="$(StanzaSharpVersion)" />
  </ItemGroup>

</Project>
