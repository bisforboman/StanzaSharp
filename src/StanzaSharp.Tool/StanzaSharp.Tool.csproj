<Project Sdk="Microsoft.NET.Sdk">

  <!-- The stanzasharp .NET tool: model downloads (ModelDownloader) without native libtorch. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>stanzasharp</ToolCommandName>
    <PackageId>StanzaSharp.Tool</PackageId>
    <Description>The stanzasharp command: downloads Stanza's English models for StanzaSharp, checked against their MD5s, e.g. in a Dockerfile or CI. "stanzasharp download DIR [--package default_fast] [--processors tokenize,mwt,pos]". Needs no native libtorch.</Description>
    <PackageTags>nlp;stanza;models;download;dotnet-tool</PackageTags>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\StanzaSharp\StanzaSharp.csproj" />
    <None Include="..\..\NOTICE" Pack="true" PackagePath="/" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
