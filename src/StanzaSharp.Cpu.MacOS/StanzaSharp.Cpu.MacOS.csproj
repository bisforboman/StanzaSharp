<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>StanzaSharp.Cpu.MacOS</PackageId>
    <Description>StanzaSharp plus the CPU libtorch for macOS on Apple Silicon (arm64) only. Use instead of StanzaSharp + TorchSharp-cpu, which restores libtorch for Linux, Windows and macOS (about 265 MB of downloads); this restores one platform's. Needs Homebrew's OpenMP: brew install libomp.</Description>
    <LibTorchPackage>libtorch-cpu-osx-arm64</LibTorchPackage>
  </PropertyGroup>

  <Import Project="..\StanzaSharp.Cpu.props" />

</Project>
