<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>StanzaSharp.Cpu.Linux</PackageId>
    <Description>StanzaSharp plus the CPU libtorch for Linux x64 only. Use instead of StanzaSharp + TorchSharp-cpu, which restores libtorch for Linux, Windows and macOS (about 265 MB of downloads); this restores one platform's.</Description>
    <LibTorchPackage>libtorch-cpu-linux-x64</LibTorchPackage>
  </PropertyGroup>

  <Import Project="..\StanzaSharp.Cpu.props" />

</Project>
