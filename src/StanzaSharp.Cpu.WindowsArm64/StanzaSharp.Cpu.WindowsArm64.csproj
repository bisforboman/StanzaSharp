<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>StanzaSharp.Cpu.WindowsArm64</PackageId>
    <Description>StanzaSharp plus the CPU libtorch for Windows on Arm64 only. TorchSharp-cpu has no Windows Arm64 libtorch, so on Windows on Arm this is the package to use.</Description>
    <LibTorchPackage>libtorch-cpu-win-arm64</LibTorchPackage>
  </PropertyGroup>

  <Import Project="..\StanzaSharp.Cpu.props" />

</Project>
