<Project>
  <PropertyGroup>
    <StyleBroPreset>1.0</StyleBroPreset>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- Only src/StanzaSharp is packed: one StanzaSharp package that carries the other assemblies. -->
    <IsPackable>false</IsPackable>
    <!-- Releases override this from the git tag (release.yml). -->
    <Version>0.1.0-dev</Version>
    <Authors>Jakob Boman</Authors>
    <Copyright>Copyright 2026 Jakob Boman</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/bisforboman/StanzaSharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/bisforboman/StanzaSharp</RepositoryUrl>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <NoWarn>$(NoWarn);CS1573</NoWarn>
    <!-- Report the built-in .NET rules .editorconfig turns on (IDE0055, IDE0005, ...) on build too, not only in
         dotnet format. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- IDE0005 (unused usings) only runs on build when the compiler parses doc comments. src/* needs the XML docs
         anyway (below); tests and samples generate them only for this, without requiring docs. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn Condition="'$([System.IO.Path]::GetFileName($([System.IO.Path]::GetDirectoryName($(MSBuildProjectDirectory)))))' != 'src'">$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- StyleBro: analyzers whose findings `stylebro-migrate format` fixes (CLAUDE.md, "Code style"). A build-time
       dependency only: PrivateAssets keeps it out of the packages' dependencies. -->
  <ItemGroup>
    <PackageReference Include="StyleBro.Analyzers" Version="0.7.0-alpha.1" PrivateAssets="all" />
  </ItemGroup>

  <!-- Library projects (src/*): XML docs, and every public member must have them. The public API is the
       facade (Pipeline, PipelineOptions, PipelineBackend, CharlmCacheOptions, ModelDownloader, Processor;
       StanzaSharp.Cuda's CudaBackend) and Core's document model; everything else is internal, shared across the
       StanzaSharp assemblies below. -->
  <PropertyGroup Condition="'$([System.IO.Path]::GetFileName($([System.IO.Path]::GetDirectoryName($(MSBuildProjectDirectory)))))' == 'src'">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
    <!-- Trimming and Native AOT (docs/aot.md): the trim/AOT analyzers on every assembly of the StanzaSharp package, and
         the assemblies marked trimmable. Not StanzaSharp.Cuda (TorchSharp isn't AOT-safe) or the Tool (a .NET tool). -->
    <IsAotCompatible Condition="'$(MSBuildProjectName)' != 'StanzaSharp.Cuda' And '$(MSBuildProjectName)' != 'StanzaSharp.Tool'">true</IsAotCompatible>
  </PropertyGroup>
  <!-- API compatibility: `dotnet pack` of the two library packages compares their public API with the last release's
       package from nuget.org and fails on a binary-breaking change (CP0001, CP0002, ...). tools/changelog.py release moves
       the baseline to the release before the one it writes, so every pack, the release's own included, is checked
       against a published version. An intentional break (a major version, the owner's decision) is accepted by
       regenerating the suppression file: `dotnet pack src/<project> -p:ApiCompatGenerateSuppressionFile=true`. Off for
       0.x versions (the 0.1.0-dev default, verify-package.ps1's 0.0.0-verify.*): an assembly version below the
       baseline's is itself an error (CP0003). CI's build-test packs with a version of its own to run the check. -->
  <PropertyGroup Condition="('$(MSBuildProjectName)' == 'StanzaSharp' Or '$(MSBuildProjectName)' == 'StanzaSharp.Cuda') And !$(Version.StartsWith('0.'))">
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>1.15.0</PackageValidationBaselineVersion>
  </PropertyGroup>
  <ItemGroup Condition="'$([System.IO.Path]::GetFileName($([System.IO.Path]::GetDirectoryName($(MSBuildProjectDirectory)))))' == 'src'">
    <InternalsVisibleTo Include="StanzaSharp;StanzaSharp.Cuda;StanzaSharp.Nn;StanzaSharp.Tokenize;StanzaSharp.Mwt;StanzaSharp.Pos;StanzaSharp.Lemma;StanzaSharp.Constituency;StanzaSharp.Depparse;StanzaSharp.Ner;StanzaSharp.Sentiment;StanzaSharp.Coref;StanzaSharp.Tool;StanzaSharp.DataIngestion;StanzaSharp.TasmanianDevil"
                        Exclude="$(AssemblyName)" />
    <!-- The Cli sample compiles the Tool's DownloadCommand.cs, so it gets the Tool's access. -->
    <InternalsVisibleTo Include="StanzaSharp.Tests;StanzaSharp.Benchmark;StanzaSharp.Cli" />
  </ItemGroup>

  <!-- The native libtorch the runnable projects (Cli, Benchmark, Tests) reference. Of the libraries only
       StanzaSharp.Cuda references TorchSharp, the managed package. STANZASHARP_CUDA=1 (environment variable or -p:)
       switches to CUDA for local GPU runs; the default and CI stay on CPU. -->
  <PropertyGroup>
    <!-- The one place these versions are set. The StanzaSharp package bakes them into its build check (STANZA001). -->
    <TorchSharpVersion>0.107.0</TorchSharpVersion>
    <LibTorchVersion>2.10.0</LibTorchVersion>
    <TorchSharpNative>TorchSharp-cpu</TorchSharpNative>
    <TorchSharpNative Condition="'$(STANZASHARP_CUDA)' == '1' Or '$(STANZASHARP_CUDA)' == 'true'">TorchSharp-cuda-windows</TorchSharpNative>
  </PropertyGroup>
  <!-- TorchSharp-cpu has no Windows Arm64 libtorch (TorchSharp itself has the win-arm64 LibTorchSharp), so on a
       Windows Arm64 machine the runnable projects (tests/, samples/) also get libtorch-cpu-win-arm64, except those that set
       StanzaSharpNoLibTorch (tests/StanzaSharp.ManagedCheck, which proves the managed backend needs no libtorch). -->
  <ItemGroup Condition="'$([System.IO.Path]::GetFileName($([System.IO.Path]::GetDirectoryName($(MSBuildProjectDirectory)))))' != 'src' And '$(TorchSharpNative)' == 'TorchSharp-cpu' And '$(StanzaSharpNoLibTorch)' != 'true' And $([MSBuild]::IsOSPlatform('Windows')) And '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'Arm64'">
    <PackageReference Include="libtorch-cpu-win-arm64" Version="$(LibTorchVersion)" />
  </ItemGroup>
</Project>
