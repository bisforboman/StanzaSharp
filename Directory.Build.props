<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- Only src/StanzaSharp is packed: one StanzaSharp package that carries the other assemblies. -->
    <IsPackable>false</IsPackable>
    <!-- Releases override this from the git tag (release.yml). -->
    <Version>0.1.0-dev</Version>
    <Authors>Jakob Boman</Authors>
    <Copyright>Copyright 2026 Jakob Boman</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/bisforboman/StanzaSharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/bisforboman/StanzaSharp</RepositoryUrl>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <NoWarn>$(NoWarn);CS1573</NoWarn>
  </PropertyGroup>

  <!-- Library projects (src/*): XML docs, and every public member must have them. The public API is the
       facade (Pipeline, PipelineOptions, CharlmCacheOptions, ModelDownloader) and Core's document model;
       everything else is internal, shared across the StanzaSharp assemblies below. -->
  <PropertyGroup Condition="'$([System.IO.Path]::GetFileName($([System.IO.Path]::GetDirectoryName($(MSBuildProjectDirectory)))))' == 'src'">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup Condition="'$([System.IO.Path]::GetFileName($([System.IO.Path]::GetDirectoryName($(MSBuildProjectDirectory)))))' == 'src'">
    <InternalsVisibleTo Include="StanzaSharp;StanzaSharp.Nn;StanzaSharp.Tokenize;StanzaSharp.Mwt;StanzaSharp.Pos;StanzaSharp.Lemma;StanzaSharp.Constituency;StanzaSharp.Depparse;StanzaSharp.Ner;StanzaSharp.Sentiment"
                        Exclude="$(AssemblyName)" />
    <InternalsVisibleTo Include="StanzaSharp.Tests;StanzaSharp.Benchmark" />
  </ItemGroup>

  <!-- The native libtorch the runnable projects (Cli, Benchmark, Tests) reference. Libraries use only the
       managed TorchSharp package. STANZASHARP_CUDA=1 (environment variable or -p:) switches to CUDA for local
       GPU runs; the default and CI stay on CPU. -->
  <PropertyGroup>
    <!-- The one place these versions are set. The StanzaSharp package bakes them into its build check (STANZA001). -->
    <TorchSharpVersion>0.107.0</TorchSharpVersion>
    <LibTorchVersion>2.10.0</LibTorchVersion>
    <TorchSharpNative>TorchSharp-cpu</TorchSharpNative>
    <TorchSharpNative Condition="'$(STANZASHARP_CUDA)' == '1' Or '$(STANZASHARP_CUDA)' == 'true'">TorchSharp-cuda-windows</TorchSharpNative>
  </PropertyGroup>
  <!-- TorchSharp-cpu has no Windows Arm64 libtorch (TorchSharp itself has the win-arm64 LibTorchSharp), so on a
       Windows Arm64 machine the runnable projects (tests/, samples/) also get libtorch-cpu-win-arm64. -->
  <ItemGroup Condition="'$([System.IO.Path]::GetFileName($([System.IO.Path]::GetDirectoryName($(MSBuildProjectDirectory)))))' != 'src' And '$(TorchSharpNative)' == 'TorchSharp-cpu' And $([MSBuild]::IsOSPlatform('Windows')) And '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'Arm64'">
    <PackageReference Include="libtorch-cpu-win-arm64" Version="$(LibTorchVersion)" />
  </ItemGroup>
</Project>
