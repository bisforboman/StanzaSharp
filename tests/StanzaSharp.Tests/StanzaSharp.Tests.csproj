<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <!-- StanzaSharpNoLibTorch=true (the linux-arm64 CI job, which has no libtorch): only the tests that need none can pass. -->
    <PackageReference Include="$(TorchSharpNative)" Version="$(TorchSharpVersion)" Condition="'$(StanzaSharpNoLibTorch)' != 'true'" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- GPU tests exist only in CUDA builds (STANZASHARP_CUDA=1), so a CPU run has nothing to skip. -->
  <ItemGroup Condition="'$(TorchSharpNative)' != 'TorchSharp-cuda-windows'">
    <Compile Remove="GpuTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\StanzaSharp\StanzaSharp.csproj" />
    <ProjectReference Include="..\..\src\StanzaSharp.Core\StanzaSharp.Core.csproj" />
    <ProjectReference Include="..\..\src\StanzaSharp.Nn\StanzaSharp.Nn.csproj" />
    <ProjectReference Include="..\..\src\StanzaSharp.Cuda\StanzaSharp.Cuda.csproj" />
    <ProjectReference Include="..\..\src\StanzaSharp.Tokenize\StanzaSharp.Tokenize.csproj" />
    <ProjectReference Include="..\..\src\StanzaSharp.Mwt\StanzaSharp.Mwt.csproj" />
    <ProjectReference Include="..\..\src\StanzaSharp.Pos\StanzaSharp.Pos.csproj" />
    <ProjectReference Include="..\..\src\StanzaSharp.Lemma\StanzaSharp.Lemma.csproj" />
    <ProjectReference Include="..\..\src\StanzaSharp.Constituency\StanzaSharp.Constituency.csproj" />
    <ProjectReference Include="..\..\src\StanzaSharp.Depparse\StanzaSharp.Depparse.csproj" />
    <ProjectReference Include="..\..\src\StanzaSharp.Ner\StanzaSharp.Ner.csproj" />
    <ProjectReference Include="..\..\src\StanzaSharp.Sentiment\StanzaSharp.Sentiment.csproj" />
    <!-- Built first, run by ManagedCheckTests in a process of its own (no libtorch); not referenced as an assembly. -->
    <ProjectReference Include="..\StanzaSharp.ManagedCheck\StanzaSharp.ManagedCheck.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>